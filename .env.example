# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string for the submissions database.
# Works with Neon, Vercel Postgres, Supabase, or any standard Postgres provider.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Shared password for the /admin dashboard (single-operator auth, not per-user accounts).
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-too

# Cloudflare R2 (S3-compatible) — used for uploading photos/flyers directly from the admin.
# Generate an API token in the Cloudflare dashboard: R2 -> Manage R2 API Tokens -> Create API Token
# (scope it to this bucket, "Object Read & Write" permission). The Account ID is shown on the
# R2 overview page.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=your-bucket-name
# Public base URL that already serves this bucket's objects (same domain your flyer links use).
R2_PUBLIC_URL_BASE=https://images.thebirdhaus.org

# Resend — sends RSVP confirmation emails. Create a key at resend.com/api-keys.
RESEND_API_KEY=change-me
# "From" address for outgoing RSVP emails. Must be on a domain verified in Resend
# (resend.com/domains) or sends will fail.
RESEND_FROM_EMAIL=RSVPs <rsvp@thebirdhaus.org>
# "From" address for band advance emails (lib/advance-email.ts). Also on a
# Resend-verified domain.
RESEND_ADVANCE_FROM_EMAIL=alex // the BIRDHAUS <advance@thebirdhaus.org>
# Receiving domain for band replies. Bands reply to advance-{token}@<this
# domain>, which Resend Inbound delivers to the email.received webhook. Easiest:
# use the managed catch-all Resend gives every account (Emails -> Receiving ->
# "Receiving address"), e.g. abc123.resend.app — any localpart is delivered, no
# DNS, and it doesn't use your one custom-domain slot. A custom subdomain works
# too but needs MX records; don't point the apex at Resend or you'll break
# thebirdhaus.org's existing mailboxes.
RESEND_ADVANCE_REPLY_DOMAIN=abc123.resend.app

# Where timesheet notifications go (new-entry alerts + the weekly unpaid
# reminder, lib/timesheet-email.ts). Defaults to alex@thebirdhaus.org if unset.
ADMIN_NOTIFY_EMAIL=alex@thebirdhaus.org

# Shared secret protecting the cron route (app/api/cron/timesheet-unpaid).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>` automatically
# when this env var is set on the project. Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# Twin Scene's public band-directory API — the canonical source of band
# profile data (bio, photo, genres, ...) and, since migration 017, the
# canonical band directory itself; Birdhaus's own bands table is a local
# overlay. Used by the admin Edit Show form's band typeahead (just-in-time
# sync of bands that only exist in Twin Scene so far) and the "Sync from
# Twin Scene" button/CLI script (fills blank fields on already-linked bands).
# Point at the www host directly (the apex redirects there). Issued from the
# Twin Scene repo with: node scripts/create-api-client.mjs <name>
TWIN_SCENE_API_URL=https://www.twinscene.org
TWIN_SCENE_API_KEY=change-me
